<?xml version="1.0" encoding="utf-8"?>
<!--
    TAZ does not use Android cloud backup or device-to-device transfer
    (API 31+ rules; API 26-30 uses backup_rules.xml). All app data is excluded
    explicitly, in addition to android:allowBackup="false" in the manifest.

    TAZ's own local backup/restore is a separate, user-initiated feature
    that writes to a user-chosen location and does not rely on this system.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
