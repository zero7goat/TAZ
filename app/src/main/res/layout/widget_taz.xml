<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: shortcuts only. It never shows anything from the vault. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_new_note"
        style="@style/TazWidgetButton"
        android:text="@string/widget_new_note" />

    <TextView
        android:id="@+id/widget_codes"
        style="@style/TazWidgetButton"
        android:text="@string/widget_codes" />

    <TextView
        android:id="@+id/widget_lock"
        style="@style/TazWidgetButton"
        android:text="@string/widget_lock" />
</LinearLayout>
